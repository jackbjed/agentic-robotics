#!/usr/bin/env bash
# real/astra-skill: the model writes the skill in one call after one look, then real/run program runs it (real/astra_skill.py)
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
unset VIRTUAL_ENV VIRTUAL_ENV_PROMPT PYTHONPATH CONDA_PREFIX
export PYTHONNOUSERSITE=1
cd "$ROOT" && exec "$ROOT/.venv/bin/python" -I "$ROOT/real/astra_skill.py" "$@"
