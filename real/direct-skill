#!/usr/bin/env bash
# real/direct-skill: the skill written on the spot without a simulator, rewritten after a failure on the robot (real/direct_skill.py)
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
unset VIRTUAL_ENV VIRTUAL_ENV_PROMPT PYTHONPATH CONDA_PREFIX
export PYTHONNOUSERSITE=1
cd "$ROOT" && exec "$ROOT/.venv/bin/python" -I "$ROOT/real/direct_skill.py" "$@"
