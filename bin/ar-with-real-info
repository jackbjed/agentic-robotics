#!/usr/bin/env bash
# ar-with-real-info: the launcher of a with_real_info session (a from-nothing Claude Code session given a text about the real robot)
# (src/agentic_robotics/bimanual/with_real_info.py): run | brief. Runs this checkout's code with the main
# checkout's environment, Python isolated (-I).
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ] && [ -f "$ROOT/.git" ]; then
  MAIN="$(sed -n 's|^gitdir: \(.*\)/\.git/worktrees/.*$|\1|p' "$ROOT/.git")"
  PY="$MAIN/.venv/bin/python"
fi
unset VIRTUAL_ENV VIRTUAL_ENV_PROMPT PYTHONPATH CONDA_PREFIX
export PYTHONNOUSERSITE=1 MUJOCO_GL=egl
cd "$ROOT" && exec "$PY" -I -c 'import sys; sys.path.insert(0, sys.argv[1]); from agentic_robotics.bimanual.with_real_info import main; sys.exit(main(sys.argv[2:]))' "$ROOT/src" "$@"
