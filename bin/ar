#!/usr/bin/env bash
# ar: the project's command line, run with the project's own environment (never an inherited venv / user site).
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
unset VIRTUAL_ENV VIRTUAL_ENV_PROMPT PYTHONPATH CONDA_PREFIX
export PYTHONNOUSERSITE=1
cd "$ROOT" && exec "$ROOT/.venv/bin/python" -I -m agentic_robotics.cli "$@"
